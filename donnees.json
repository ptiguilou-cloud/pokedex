{"chaine":"ptiguilou","pokedex_max":99,"champion":null,"defenses":0,"dresseurs":[],"dernieres_captures":[],"univers":{"nom":"Fifrelins","lore":"Dans le Nord et le Pas-de-Calais, on se racontait autrefois des histoires à la veillée : la Blanque Jument des marais, l'âne gris de Vaudricourt et ses grelots, le crapaud des puits, le Kludde et sa chaîne, le lion d'or du beffroi d'Arras… Une nuit de brume, les animaux de ces légendes se sont échappés des mémoires et des greniers : ce sont les Fifrelins. Les dresseurs les attrapent à la lueur d'une Lampe de mineur et les entraînent dans l'Arène. Neuf Légendes, plus anciennes que les beffrois, ne se montrent que très rarement…","domaines":{"Braise":"#e8562a","Marée":"#2f80ed","Orage":"#e0b000","Vent":"#5fb4e8","Terril":"#8a6a4c","Bocage":"#3fa34d","Frimas":"#6fd0e0","Lumière":"#e9a93a","Nuit":"#5b4a7a","Force":"#b23a48","Sortilège":"#b65ad6","Carnaval":"#d0368a"},"niveaux":[4,8],"creatures":[{"numero":1,"stade":1,"legendaire":false,"lignee":1,"etat":"inconnu","decouvert":false,"nom":"???","types":[]},{"numero":2,"stade":2,"legendaire":false,"lignee":1,"etat":"inconnu","decouvert":false,"nom":"???","types":[]},{"numero":3,"stade":3,"legendaire":false,"lignee":1,"etat":"inconnu","decouvert":false,"nom":"???","types":[]},{"numero":4,"stade":1,"legendaire":false,"lignee":2,"etat":"inconnu","decouvert":false,"nom":"???","types":[]},{"numero":5,"stade":2,"legendaire":false,"lignee":2,"etat":"inconnu","decouvert":false,"nom":"???","types":[]},{"numero":6,"stade":3,"legendaire":false,"lignee":2,"etat":"inconnu","decouvert":false,"nom":"???","types":[]},{"numero":7,"stade":1,"legendaire":false,"lignee":3,"etat":"inconnu","decouvert":false,"nom":"???","types":[]},{"numero":8,"stade":2,"legendaire":false,"lignee":3,"etat":"inconnu","decouvert":false,"nom":"???","types":[]},{"numero":9,"stade":3,"legendaire":false,"lignee":3,"etat":"inconnu","decouvert":false,"nom":"???","types":[]},{"numero":10,"stade":1,"legendaire":false,"lignee":4,"